<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@color/background_dark">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/rentar_vehiculo"
        android:textColor="@color/white"
        android:textSize="20sp"
        android:layout_gravity="center"
        android:layout_marginBottom="24dp" />

    <TextView
        android:id="@+id/tvRentaPlaca"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="PLACA"
        android:textColor="@color/white"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvRentaDetalles"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Marca - Modelo - Año"
        android:textColor="@color/text_secondary"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/seleccionar_cliente"
        android:textColor="@color/white"
        android:layout_marginBottom="4dp" />

    <Spinner
        android:id="@+id/spClientes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:backgroundTint="@color/white"
        android:layout_marginBottom="16dp" />

    <EditText
        android:id="@+id/etDiasRenta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/dias_renta"
        android:inputType="number"
        android:textColor="@color/white"
        android:textColorHint="@color/text_secondary"
        android:backgroundTint="@color/white"
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/tvCostoDiario"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="COBRO POR DIA: $0.0"
        android:textColor="@color/white" />

    <TextView
        android:id="@+id/tvCostoTotal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="COBRO TOTAL: $0.0"
        android:textColor="@color/white"
        android:textStyle="bold"
        android:layout_marginBottom="24dp" />

    <Button
        android:id="@+id/btnConfirmarRenta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/confirmar_renta" />

    <Button
        android:id="@+id/btnCancelarRenta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/cancelar"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        android:textColor="@color/white" />

</LinearLayout>