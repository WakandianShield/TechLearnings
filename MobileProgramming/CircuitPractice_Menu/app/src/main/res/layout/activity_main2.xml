<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F3EDFF">

    <include layout="@layout/layout_toolbar" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvTitleResults"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="RESULTADOS DEL CIRCUITO"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="center"
            android:textColor="#1976D2"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/tvFinalResults"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Resultados finales"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginTop="8dp"
            android:textColor="#5323AF" />

        <LinearLayout
            android:id="@+id/layoutResults"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:orientation="vertical"
            android:layout_marginTop="12dp"
            android:padding="4dp"
            android:background="#F3EDFF"
            android:gravity="center">

            <ImageView
                android:id="@+id/ivCircuit"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitCenter"
                android:src="@drawable/image_circuit"
                android:contentDescription="Imagen del circuito" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PROCEDIMIENTO:"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/tvCalculations"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="4dp"
            android:layout_weight="1"
            android:background="#F3EDFF"
            android:padding="8dp"
            android:text="..."
            android:textColor="#444444"
            android:textSize="7sp"
            android:typeface="monospace"
            android:scrollbars="vertical" />

        <Button
            android:id="@+id/btnBack"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="VOLVER A CALCULAR"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp" />
    </LinearLayout>

</LinearLayout>
