<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F7">

    <include
        layout="@layout/layout_toolbar"
        android:id="@+id/toolbar_layout"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar_layout">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/mon"
                android:text="Chocolate"
                android:textColor="#1D1D1F"
                android:textSize="40sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/mon"
                android:text="Completa la información"
                android:textColor="#86868B"
                android:textSize="13sp"
                android:layout_marginBottom="16dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/mon"
                android:text="Nombre"
                android:textColor="#1D1D1F"
                android:textSize="11sp"
                android:textStyle="bold"
                android:layout_marginLeft="4dp" />

            <EditText
                android:id="@+id/etNombre"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:background="@drawable/bg_edittext"
                android:fontFamily="@font/mon"
                android:hint="Nombre"
                android:inputType="textPersonName"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:textSize="13sp"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="8dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/mon"
                        android:text="Marca"
                        android:textColor="#1D1D1F"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:layout_marginLeft="4dp" />

                    <EditText
                        android:id="@+id/etMarca"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_edittext"
                        android:fontFamily="@font/mon"
                        android:hint="Marca"
                        android:inputType="text"
                        android:paddingLeft="12dp"
                        android:paddingRight="12dp"
                        android:textSize="13sp"
                        android:layout_marginBottom="8dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.7"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/mon"
                        android:text="% Cacao"
                        android:textColor="#1D1D1F"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:layout_marginLeft="4dp" />

                    <EditText
                        android:id="@+id/etPorcentajeCacao"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_edittext"
                        android:fontFamily="@font/mon"
                        android:hint="70"
                        android:inputType="numberDecimal"
                        android:paddingLeft="12dp"
                        android:paddingRight="12dp"
                        android:textSize="13sp"
                        android:layout_marginBottom="8dp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="8dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/mon"
                        android:text="País Origen"
                        android:textColor="#1D1D1F"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:layout_marginLeft="4dp" />

                    <EditText
                        android:id="@+id/etPaisOrigen"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_edittext"
                        android:fontFamily="@font/mon"
                        android:hint="Mexico"
                        android:inputType="text"
                        android:digits="abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZáéíóúÁÉÍÓÚñÑ "
                        android:paddingLeft="12dp"
                        android:paddingRight="12dp"
                        android:textSize="13sp"
                        android:layout_marginBottom="8dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/mon"
                        android:text="Contacto"
                        android:textColor="#1D1D1F"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:layout_marginLeft="4dp" />

                    <EditText
                        android:id="@+id/etTelefono"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_edittext"
                        android:fontFamily="@font/mon"
                        android:hint="Teléfono"
                        android:inputType="phone"
                        android:maxLength="10"
                        android:paddingLeft="12dp"
                        android:paddingRight="12dp"
                        android:textSize="13sp"
                        android:layout_marginBottom="8dp" />
                </LinearLayout>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#E5E5E7"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="12dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="8dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/mon"
                        android:text="Presentación"
                        android:textColor="#1D1D1F"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:layout_marginLeft="4dp" />

                    <Spinner
                        android:id="@+id/spinnerPresentacion"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_edittext"
                        android:layout_marginBottom="8dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/mon"
                        android:text="Tipo Cacao"
                        android:textColor="#1D1D1F"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:layout_marginLeft="4dp" />

                    <Spinner
                        android:id="@+id/spinnerTipoCacao"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_edittext"
                        android:layout_marginBottom="8dp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="8dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/mon"
                        android:text="Perfil Sabor"
                        android:textColor="#1D1D1F"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:layout_marginLeft="4dp" />

                    <Spinner
                        android:id="@+id/spinnerPerfilSabor"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_edittext"
                        android:layout_marginBottom="8dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/mon"
                        android:text="Tipo"
                        android:textColor="#1D1D1F"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:layout_marginLeft="4dp" />

                    <Spinner
                        android:id="@+id/spinnerTipo"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_edittext"
                        android:layout_marginBottom="8dp" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/mon"
                android:text="Peso"
                android:textColor="#1D1D1F"
                android:textSize="11sp"
                android:textStyle="bold"
                android:layout_marginLeft="4dp" />

            <Spinner
                android:id="@+id/spinnerPeso"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:background="@drawable/bg_edittext"
                android:layout_marginBottom="16dp" />

            <Button
                android:id="@+id/btnGuardar"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:backgroundTint="#1D1D1F"
                android:fontFamily="@font/mon"
                android:text="Guardar Chocolate"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
